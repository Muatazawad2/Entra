{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "cert-expiry-digest",
      "metadata": {
        "description": "Name for the Logic App."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Region for the Logic App and its connection."
      }
    },
    "digestRecipient": {
      "type": "string",
      "metadata": {
        "description": "Email address that receives the daily digest and owner alerts."
      }
    },
    "office365ConnectionName": {
      "type": "string",
      "defaultValue": "office365-cert-digest",
      "metadata": {
        "description": "Name for the Office 365 Outlook API connection used to send mail."
      }
    }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('office365ConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "[parameters('office365ConnectionName')]",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "actions": {
            "Initialize_alertRows": {
              "inputs": {
                "variables": [
                  {
                    "name": "alertRows",
                    "type": "string",
                    "value": ""
                  }
                ]
              },
              "runAfter": {
                "Initialize_csvRows": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable"
            },
            "Initialize_csvRows": {
              "inputs": {
                "variables": [
                  {
                    "name": "csvRows",
                    "type": "string",
                    "value": "AppName,AppId,SsoMode,CertExpiresUTC,DaysLeft,NotificationAddresses\n"
                  }
                ]
              },
              "runAfter": {
                "Initialize_nextUrl": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable"
            },
            "Initialize_nextUrl": {
              "inputs": {
                "variables": [
                  {
                    "name": "nextUrl",
                    "type": "string",
                    "value": "https://graph.microsoft.com/v1.0/servicePrincipals?$select=id,appId,displayName,preferredSingleSignOnMode,notificationEmailAddresses,keyCredentials&$top=999"
                  }
                ]
              },
              "runAfter": {},
              "type": "InitializeVariable"
            },
            "Send_digest": {
              "inputs": {
                "body": {
                  "Attachments": [
                    {
                      "ContentBytes": "@{base64(variables('csvRows'))}",
                      "Name": "saml-inventory.csv"
                    }
                  ],
                  "Body": "@{concat('<div style=\"font-family:Segoe UI,Arial,sans-serif;color:#201F1E;max-width:700px;\">','<table role=\"presentation\" width=\"100%\" style=\"background-color:#0078D4;border-radius:6px 6px 0 0;\"><tr><td style=\"padding:16px 20px;\">','<span style=\"font-size:20px;color:#ffffff;font-weight:600;\">🔐 SAML Certificate Expiry Digest</span><br>','<span style=\"font-size:13px;color:#D6E8FB;\">Daily report · ', formatDateTime(utcNow(),'MMMM d, yyyy'), '</span>','</td></tr></table>','<table role=\"presentation\" width=\"100%\" style=\"border:1px solid #E1E1E1;border-top:none;\"><tr><td style=\"padding:16px 20px;\">','<p style=\"margin:0 0 12px 0;\">Hi,</p>',if(equals(variables('alertCount'), 0),'<p style=\"margin:0 0 12px 0;\">✅ Good news — no SAML signing certificates are expiring within the next 60 days. No action needed today.</p>',concat('<p style=\"margin:0 0 12px 0;\">⚠️ <b>', string(variables('alertCount')), '</b> SAML signing certificate(s) are expiring within the next 60 days and need attention:</p>','<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" style=\"border-collapse:collapse;font-size:13px;\">','<tr style=\"background-color:#0078D4;color:#ffffff;text-align:left;\"><th style=\"padding:8px;\">Status</th><th style=\"padding:8px;\">Application</th><th style=\"padding:8px;text-align:center;\">Days Left</th><th style=\"padding:8px;\">Expires (UTC)</th><th style=\"padding:8px;\">Notify Addresses</th></tr>',variables('alertRows'),'</table>')),'<p style=\"margin:16px 0 0 0;font-size:12px;color:#605E5C;\"><b>Legend:</b> 🔴 Critical (≤ 7 days) &nbsp;|&nbsp; 🟠 Warning (≤ 30 days) &nbsp;|&nbsp; 🔵 Notice (≤ 60 days)</p>','<p style=\"margin:12px 0 0 0;font-size:13px;color:#605E5C;\"><b>To renew a certificate:</b> Entra admin center &gt; Enterprise applications &gt; select the app &gt; Single sign-on &gt; SAML Certificates &gt; create and activate a new certificate before the old one expires.</p>','</td></tr></table>','<table role=\"presentation\" width=\"100%\" style=\"background-color:#F3F2F1;border:1px solid #E1E1E1;border-top:none;border-radius:0 0 6px 6px;\"><tr><td style=\"padding:12px 20px;font-size:12px;color:#605E5C;\">','A full inventory of all signing certificates (not just those expiring soon) is attached as <b>saml-inventory.csv</b>.<br>','This is an automated message from the <b>', workflow().name, '</b> Logic App, sent daily at 7:00 AM Central.','</td></tr></table>','</div>')}",
                  "Importance": "Normal",
                  "IsHtml": true,
                  "Subject": "@if(equals(variables('alertCount'), 0), concat('✅ SAML certificate digest (lab) – all clear – ', formatDateTime(utcNow(), 'yyyy-MM-dd')), concat('⚠️ SAML certificate digest (lab) – ', string(variables('alertCount')), ' expiring soon – ', formatDateTime(utcNow(), 'yyyy-MM-dd')))",
                  "To": "@parameters('digestRecipient')"
                },
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail"
              },
              "runAfter": {
                "Until_all_pages": [
                  "Succeeded"
                ]
              },
              "type": "ApiConnection"
            },
            "Until_all_pages": {
              "actions": {
                "For_each_app": {
                  "actions": {
                    "Filter_sign_certs": {
                      "inputs": {
                        "from": "@coalesce(items('For_each_app')?['keyCredentials'], createArray())",
                        "where": "@equals(item()?['usage'], 'Sign')"
                      },
                      "runAfter": {},
                      "type": "Query"
                    },
                    "For_each_cert": {
                      "actions": {
                        "Append_csv": {
                          "inputs": {
                            "name": "csvRows",
                            "value": "\"@{items('For_each_app')?['displayName']}\",@{items('For_each_app')?['appId']},@{items('For_each_app')?['preferredSingleSignOnMode']},@{items('For_each_cert')?['endDateTime']},@{outputs('Compose_days')},@{outputs('Compose_notify')}\n"
                          },
                          "runAfter": {
                            "Compose_rowcolor": [
                              "Succeeded"
                            ]
                          },
                          "type": "AppendToStringVariable"
                        },
                        "Check_due": {
                          "actions": {
                            "Append_alert": {
                              "inputs": {
                                "name": "alertRows",
                                "value": "<tr style='background-color:@{outputs('Compose_rowcolor')};'><td style='padding:8px;border-bottom:1px solid #E1E1E1;'>@{outputs('Compose_severity')}</td><td style='padding:8px;border-bottom:1px solid #E1E1E1;'><b>@{items('For_each_app')?['displayName']}</b></td><td style='padding:8px;border-bottom:1px solid #E1E1E1;text-align:center;'>@{outputs('Compose_days')}</td><td style='padding:8px;border-bottom:1px solid #E1E1E1;'>@{items('For_each_cert')?['endDateTime']}</td><td style='padding:8px;border-bottom:1px solid #E1E1E1;'>@{if(equals(outputs('Compose_notify'), ''), '—', outputs('Compose_notify'))}</td></tr>"
                              },
                              "runAfter": {},
                              "type": "AppendToStringVariable"
                            },
                            "Increment_alertCount": {
                              "inputs": {
                                "name": "alertCount",
                                "value": 1
                              },
                              "runAfter": {
                                "Append_alert": [
                                  "Succeeded"
                                ]
                              },
                              "type": "IncrementVariable"
                            }
                          },
                          "expression": {
                            "and": [
                              {
                                "lessOrEquals": [
                                  "@outputs('Compose_days')",
                                  60
                                ]
                              }
                            ]
                          },
                          "runAfter": {
                            "Append_csv": [
                              "Succeeded"
                            ]
                          },
                          "type": "If"
                        },
                        "Check_owner_alert": {
                          "actions": {
                            "Send_owner_alert": {
                              "inputs": {
                                "body": {
                                  "Body": "<div style='font-family:Segoe UI,Arial,sans-serif;font-size:14px;color:#201F1E;max-width:650px;'><p style=\"font-size:16px;margin:0 0 12px 0;\">⏰ <b>Action needed: certificate renewal</b></p><p style=\"margin:0 0 12px 0;\">The SAML signing certificate for <b>@{items('For_each_app')?['displayName']}</b> (appId <code>@{items('For_each_app')?['appId']}</code>) expires on <b>@{items('For_each_cert')?['endDateTime']} UTC</b> — that's <b>@{string(outputs('Compose_days'))} day(s)</b> from now.</p><p style=\"margin:0 0 12px 0;\"><b>To renew:</b> Entra admin center &gt; Enterprise applications &gt; this app &gt; Single sign-on &gt; SAML Certificates &gt; create and activate a new certificate before it expires.</p><p style=\"margin:12px 0 0 0;font-size:12px;color:#605E5C;\">You're receiving this because your address is listed as a notification contact for this application. This is an automated alert from the @{workflow().name} Logic App (sent at the 60/30/7-day marks).</p></div>",
                                  "Importance": "High",
                                  "IsHtml": true,
                                  "Subject": "@concat('⏰ Action needed: SAML certificate for ', items('For_each_app')?['displayName'], ' expires in ', string(outputs('Compose_days')), ' days')",
                                  "To": "@outputs('Compose_notify')"
                                },
                                "host": {
                                  "connection": {
                                    "name": "@parameters('$connections')['office365']['connectionId']"
                                  }
                                },
                                "method": "post",
                                "path": "/v2/Mail"
                              },
                              "runAfter": {},
                              "type": "ApiConnection"
                            }
                          },
                          "expression": {
                            "and": [
                              {
                                "not": {
                                  "equals": [
                                    "@outputs('Compose_notify')",
                                    ""
                                  ]
                                }
                              },
                              {
                                "or": [
                                  {
                                    "equals": [
                                      "@outputs('Compose_days')",
                                      60
                                    ]
                                  },
                                  {
                                    "equals": [
                                      "@outputs('Compose_days')",
                                      30
                                    ]
                                  },
                                  {
                                    "equals": [
                                      "@outputs('Compose_days')",
                                      7
                                    ]
                                  }
                                ]
                              }
                            ]
                          },
                          "runAfter": {
                            "Check_due": [
                              "Succeeded"
                            ]
                          },
                          "type": "If"
                        },
                        "Compose_days": {
                          "inputs": "@div(sub(ticks(outputs('Compose_endDay')), ticks(outputs('Compose_today'))), 864000000000)",
                          "runAfter": {
                            "Compose_today": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose"
                        },
                        "Compose_endDay": {
                          "inputs": "@concat(formatDateTime(items('For_each_cert')?['endDateTime'], 'yyyy-MM-dd'), 'T00:00:00Z')",
                          "runAfter": {},
                          "type": "Compose"
                        },
                        "Compose_notify": {
                          "inputs": "@join(coalesce(items('For_each_app')?['notificationEmailAddresses'], createArray()), ';')",
                          "runAfter": {
                            "Compose_days": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose"
                        },
                        "Compose_today": {
                          "inputs": "@concat(formatDateTime(utcNow(), 'yyyy-MM-dd'), 'T00:00:00Z')",
                          "runAfter": {
                            "Compose_endDay": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose"
                        },
                        "Compose_severity": {
                          "inputs": "@if(lessOrEquals(outputs('Compose_days'), 7), '🔴 Critical', if(lessOrEquals(outputs('Compose_days'), 30), '🟠 Warning', '🔵 Notice'))",
                          "runAfter": {
                            "Compose_notify": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose"
                        },
                        "Compose_rowcolor": {
                          "inputs": "@if(lessOrEquals(outputs('Compose_days'), 7), '#FDE7E9', if(lessOrEquals(outputs('Compose_days'), 30), '#FFF4CE', '#EFF6FC'))",
                          "runAfter": {
                            "Compose_severity": [
                              "Succeeded"
                            ]
                          },
                          "type": "Compose"
                        }
                      },
                      "foreach": "@body('Filter_sign_certs')",
                      "runAfter": {
                        "Filter_sign_certs": [
                          "Succeeded"
                        ]
                      },
                      "runtimeConfiguration": {
                        "concurrency": {
                          "repetitions": 1
                        }
                      },
                      "type": "Foreach"
                    }
                  },
                  "foreach": "@body('Get_page')?['value']",
                  "runAfter": {
                    "Set_nextUrl": [
                      "Succeeded"
                    ]
                  },
                  "runtimeConfiguration": {
                    "concurrency": {
                      "repetitions": 1
                    }
                  },
                  "type": "Foreach"
                },
                "Get_page": {
                  "inputs": {
                    "authentication": {
                      "audience": "https://graph.microsoft.com",
                      "type": "ManagedServiceIdentity"
                    },
                    "method": "GET",
                    "uri": "@variables('nextUrl')"
                  },
                  "runAfter": {},
                  "type": "Http"
                },
                "Set_nextUrl": {
                  "inputs": {
                    "name": "nextUrl",
                    "value": "@coalesce(body('Get_page')?['@odata.nextLink'], '')"
                  },
                  "runAfter": {
                    "Get_page": [
                      "Succeeded"
                    ]
                  },
                  "type": "SetVariable"
                }
              },
              "expression": "@equals(variables('nextUrl'), '')",
              "limit": {
                "count": 100,
                "timeout": "PT1H"
              },
              "runAfter": {
                "Initialize_alertCount": [
                  "Succeeded"
                ]
              },
              "type": "Until"
            },
            "Initialize_alertCount": {
              "inputs": {
                "variables": [
                  {
                    "name": "alertCount",
                    "type": "integer",
                    "value": 0
                  }
                ]
              },
              "runAfter": {
                "Initialize_alertRows": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable"
            }
          },
          "contentVersion": "1.0.0.0",
          "outputs": {},
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "digestRecipient": {
              "defaultValue": "",
              "type": "String"
            }
          },
          "triggers": {
            "Daily_7am_Central": {
              "evaluatedRecurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": {
                  "hours": [
                    "7"
                  ],
                  "minutes": [
                    0
                  ]
                },
                "timeZone": "Central Standard Time"
              },
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "schedule": {
                  "hours": [
                    "7"
                  ],
                  "minutes": [
                    0
                  ]
                },
                "timeZone": "Central Standard Time"
              },
              "type": "Recurrence"
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]",
                "connectionName": "[parameters('office365ConnectionName')]",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
              }
            }
          },
          "digestRecipient": {
            "value": "[parameters('digestRecipient')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppName": {
      "type": "string",
      "value": "[parameters('logicAppName')]"
    },
    "managedIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}